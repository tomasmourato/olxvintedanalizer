SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# Gemini (Google AI Studio → Get API key). Without it the worker scores with rules only.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# Web push (VAPID): generate once with `npx web-push generate-vapid-keys`. The public key must match
# apps/web/src/lib/push.ts and the push Edge Function secrets.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
